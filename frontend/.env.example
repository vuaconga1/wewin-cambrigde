# Copy these to Vercel -> Project Settings -> Environment Variables

# Public URL of this Next.js app (use your Vercel domain after first deploy)
NEXTAUTH_URL=https://cambrigde.wewin.edu.vn

# Random secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Backend API URL (NestJS must be hosted separately, e.g. Railway / Render)
NEXT_PUBLIC_API_URL=https://your-backend.example.com
